# SIGDoc — example env (safe to commit)
# Copy to .env for local reference, or paste into Render → Environment.

SIGDOC_DB_HOST=your-aiven-host.aivencloud.com
SIGDOC_DB_PORT=12345
SIGDOC_DB_NAME=defaultdb
SIGDOC_DB_USER=avnadmin
SIGDOC_DB_PASS=CHANGE_ME
SIGDOC_DB_CHARSET=utf8mb4
SIGDOC_DB_SSL=1

